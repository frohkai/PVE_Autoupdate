#!/bin/sh
t=${MOCK_GUEST:-node-${MOCK_NODE:-local}}
PKGS=0; FAIL=0; BREAK=0; REFFAIL=0; REBOOT=0
[ -f "$MOCK/beh/$t" ] && . "$MOCK/beh/$t"
case " $* " in
  *" -s "*) i=0; while [ $i -lt "$PKGS" ]; do echo "Inst pkg$i [1.0] (1.1 Debian:12)"; i=$((i+1)); done; exit 0 ;;
  *" update "*) echo "apt-get update $t" >> "$MOCK/actions"; [ "$REFFAIL" = 1 ] && { echo "E: Failed to fetch https://enterprise.proxmox.com 401"; exit 100; }; exit 0 ;;
  *" dist-upgrade "*)
    echo "apt-get dist-upgrade $t" >> "$MOCK/actions"
    [ "$FAIL" = 1 ] && { echo "dpkg: error processing package foo (--configure)"; exit 100; }
    [ "$BREAK" = 1 ] && echo "broken.service" >> "$MOCK/state/$t.failed"
    [ "$REBOOT" = 1 ] && touch /var/run/reboot-required
    echo "upgraded $PKGS"; exit 0 ;;
esac
exit 0
